{
  "name": "video-hosting-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de Video Hosting & Embedding con proveedor de medios intercambiable.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "worker:hls": "tsx scripts/hls-worker.ts",
    "cleanup:stale": "tsx scripts/cleanup-stale-uploads.ts",
    "postinstall": "prisma generate",
    "kyc:purge": "tsx scripts/purge-kyc-documents.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/lib-storage": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.3",
    "hls.js": "^1.7.3",
    "jose": "^6.2.12",
    "next": "~15.5.28",
    "plyr": "^3.8.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "prisma": "~6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
