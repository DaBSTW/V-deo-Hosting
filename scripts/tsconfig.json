{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": { "#srv/*": ["../server/lib/*"], "#shared/*": ["../shared/*"] }
  },
  "include": ["./**/*.ts"]
}
