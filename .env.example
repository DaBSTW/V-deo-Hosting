# =============================================================================
#  Plataforma de Video Hosting — configuración
#  Copia este archivo a `.env` y rellena los valores.
# =============================================================================

# --- Núcleo ------------------------------------------------------------------
# URL pública de la app (sin barra final). Se usa para enlaces e iframes.
APP_URL=https://videos.example.com
# Nombre visible en la UI.
NEXT_PUBLIC_APP_NAME=VidHost
# PostgreSQL
DATABASE_URL=postgresql://vidhost:change-me@localhost:5432/vidhost?schema=public
# Secreto de sesiones (mín. 32 caracteres): `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Permitir registro público de usuarios.
ALLOW_REGISTRATION=true
# Botón «Descargar» en el enlace directo (interruptor global; además hay un permiso por video).
ALLOW_DOWNLOADS=true
# Cuota de almacenamiento por usuario en GB (0 = sin límite). Se muestra en el Resumen
# y bloquea nuevas subidas al superarla.
STORAGE_QUOTA_GB=0
# Emails con acceso al panel de Administración (monetización, Monetag y pagos), separados por comas.
ADMIN_EMAILS=tu@email.com

# --- Interruptor del proveedor de medios --------------------------------------
# R2      → Cloudflare R2 (S3): subida con URL prefirmada, MP4 progresivo / HLS propio.
# STREAM  → Cloudflare Stream: subida TUS reanudable, transcodificación gestionada.
# Afecta a las subidas NUEVAS; cada video recuerda dónde se guardó.
# Basta con cambiarlo y reiniciar el proceso (no hace falta recompilar).
VIDEO_PROVIDER=R2

# Tamaño máximo por archivo (MB). Con R2 el límite técnico de un PUT es 5 GB.
MAX_UPLOAD_MB=5000
# Validez de las URLs de reproducción firmadas (segundos).
PLAYBACK_URL_TTL_SEC=21600
# Quién puede incrustar /embed/* (frame-ancestors). `*` o lista separada por espacios:
# EMBED_ALLOWED_ORIGINS=https://miblog.com https://*.misitio.com
EMBED_ALLOWED_ORIGINS=*

# --- Cloudflare R2 -------------------------------------------------------------
# Dashboard → R2 → Manage API tokens (permiso Object Read & Write sobre el bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=videos
# (Recomendado) Dominio propio conectado al bucket → sirve los videos desde tu
# dominio con caché de Cloudflare. Sin él se usan URLs GET prefirmadas.
R2_PUBLIC_BASE_URL=
# Miniaturas de respaldo extraídas en el edge con Cloudflare Media Transformations
# (para archivos cuyo fotograma no pudo capturar el navegador). Requiere R2_PUBLIC_BASE_URL
# en una zona con Transformations activado.
R2_MEDIA_TRANSFORMATIONS=false
# Genera HLS multi-calidad con `npm run worker:hls` (requiere ffmpeg y R2_PUBLIC_BASE_URL).
R2_HLS_ENABLED=false
# Con el worker HLS: deja también un MP4 por calidad para descargar (re-empaquetado
# sin recodificar, CPU casi nula; ocupa espacio extra en R2).
R2_HLS_DOWNLOAD_RENDITIONS=true
# Secreto HMAC compartido con workers/r2-event-forwarder (opcional).
R2_WEBHOOK_SECRET=
# Solo para pruebas locales con MinIO o jurisdicción UE:
# R2_ENDPOINT=https://<account_id>.eu.r2.cloudflarestorage.com

# --- Cloudflare Stream ---------------------------------------------------------
# Token con permiso "Stream:Edit".
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
# Host de entrega de tu cuenta: customer-<CODE>.cloudflarestream.com
CF_STREAM_DELIVERY_HOST=
# Obtenlo con `npx tsx scripts/register-stream-webhook.ts`
CF_STREAM_WEBHOOK_SECRET=
# Exigir URLs firmadas para reproducir (recomendado).
CF_STREAM_REQUIRE_SIGNED_URLS=true
# Clave de firma local (POST /accounts/:id/stream/keys → `id` y `jwk`).
# Si se omiten, cada reproducción pide un token a la API (más lento).
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_JWK=
# Duración máxima aceptada por subida (segundos).
CF_STREAM_MAX_DURATION_SEC=14400
