// =============================================================================
//  Esquema de base de datos
// -----------------------------------------------------------------------------
//  Regla de oro: los campos `provider`, `providerVideoId` y `providerMeta` son
//  PRIVADOS del backend. Nunca se serializan hacia el cliente. Todo lo público
//  (dashboard, embeds, API) se identifica exclusivamente por `publicId`.
//  El mapeo a DTO público vive en `src/server/videos/dto.ts`.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Proveedor de medios que almacena físicamente el video.
/// Se guarda POR VIDEO: si cambias VIDEO_PROVIDER en el .env, los videos
/// nuevos usarán el nuevo proveedor y los antiguos siguen reproduciéndose
/// con el adaptador con el que se subieron.
enum MediaProvider {
  R2
  STREAM
}

/// Ciclo de vida del video (agnóstico al proveedor).
enum VideoStatus {
  PENDING_UPLOAD // ticket de subida emitido, el cliente aún no confirma
  PROCESSING // subido, el proveedor lo está procesando / transcodificando
  READY // reproducible
  ERROR // falló la subida o el procesamiento
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String?
  /// Cuándo aceptó los Términos y la Política de privacidad (al registrarse).
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Personalización del reproductor (ver shared/lib/player-settings.ts).
  playerSettings  Json?

  videos  Video[]
  folders Folder[]

  // ---------------- Monetización ----------------
  /// Siempre `true` salvo que el operador la suspenda (Administración → Cuentas).
  /// Si es `false`, sus videos no muestran anuncios y no generan ganancias.
  monetizationEnabled Boolean                @default(true)
  /// Método de cobro elegido (p. ej. PAYPAL, USDT_TRC20, PAYONEER).
  payoutMethod        String?
  /// Destino del cobro (email de PayPal, dirección de wallet…).
  payoutDetails       String?
  monetizedViews      MonetizedViewDaily[]
  premiumViews        PremiumViewDaily[]
  /// Premium (sin anuncios, descargas sin espera ni límite) hasta esta fecha.
  /// Se calcula a partir de los pagos: último pago + periodo del plan + 1 día de gracia.
  premiumUntil        DateTime?
  subscriptions       Subscription[]
  earningCredits      EarningCredit[]
  payouts             Payout[]
  /// Estado de la verificación de identidad (requisito para cobrar).
  kycStatus           KycStatus              @default(NONE)
  verifications       IdentityVerification[]
}

/// Carpetas del usuario para organizar sus videos (un nivel, sin anidar).
model Folder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos Video[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model Video {
  id       String @id @default(cuid())
  /// Identificador público y opaco (p. ej. `v_8fK2xQ9mLp3a`). Único dato expuesto.
  publicId String @unique
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Al borrar la carpeta, sus videos pasan a "Sin carpeta".
  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  title         String
  status        VideoStatus      @default(PENDING_UPLOAD)
  /// Hay miniatura disponible (la genera el navegador, el proveedor o el worker).
  hasThumbnail  Boolean          @default(false)
  /// El dueño permite descargar el archivo desde la página pública.
  allowDownload Boolean          @default(true)
  /// Intro para el botón «Saltar intro» (segundos). Sin valor: se usa la del reproductor.
  introStartSec Int?
  introEndSec   Int?
  durationSec   Float?
  sizeBytes     BigInt           @default(0)
  mimeType      String?
  /// Contadores históricos (se acumulan por lotes, ver stats-buffer.ts).
  views         Int              @default(0)
  downloads     Int              @default(0)
  dailyStats    VideoDailyStat[]

  // ---------------- Campos privados (solo backend) ----------------
  provider           MediaProvider
  /// R2: object key del archivo original. STREAM: uid del video en Stream.
  providerVideoId    String
  /// Metadatos específicos del adaptador (p. ej. `{ "hls": true }` en R2).
  providerMeta       Json?
  /// Mensaje interno de error (nunca se envía al cliente tal cual).
  errorReason        String?
  /// El adaptador pidió post-procesado en segundo plano (p. ej. generar HLS
  /// en R2). El video puede estar READY (reproducción progresiva) mientras tanto.
  postProcessPending Boolean       @default(false)
  /// Bloqueo optimista para el worker de post-procesado.
  jobLockedAt        DateTime?
  // ----------------------------------------------------------------

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readyAt   DateTime?

  @@unique([provider, providerVideoId])
  @@index([userId, createdAt])
  @@index([folderId])
  @@index([status, updatedAt])
  @@index([provider, postProcessPending])
}

/// Vistas y descargas por video y día (UTC). Alimenta las gráficas del Resumen.
model VideoDailyStat {
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)
  downloads Int      @default(0)
  /// Vistas que cumplieron las reglas de monetización.
  paidViews Int      @default(0)

  @@id([videoId, day])
  @@index([day])
}

/// Ganancias diarias por usuario y nivel de país. Importes en micro-dólares
/// (1 USD = 1 000 000) para evitar errores de coma flotante.
/// Vistas monetizadas por usuario, día (UTC) y país del espectador.
/// No llevan importe: el dinero se calcula al cerrar el mes con el RPM real.
model MonetizedViewDaily {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     DateTime @db.Date
  /// Código ISO-2 del país (CF-IPCountry) o "XX" si es desconocido.
  country String   @db.VarChar(2)
  views   Int      @default(0)

  @@id([userId, day, country])
  @@index([day])
}

/// Cierre mensual: RPM real por país (del panel de Monetag) y porcentaje
/// para los creadores. Un mes solo se cierra una vez.
model RevenueSettlement {
  /// "AAAA-MM" (UTC)
  month                 String   @id @db.VarChar(7)
  /// Porcentaje del RPM real que se acredita a los creadores.
  sharePct              Int
  /// { "MX": 1500000, … } micro-USD por 1.000 vistas.
  rpmByCountry          Json
  /// RPM para los países sin valor propio.
  defaultRpmMicros      BigInt
  /// Ingresos totales reportados por Monetag (tope opcional del reparto).
  revenueMicros         BigInt?
  /// Factor aplicado si el reparto superaba el tope (1 = sin recorte).
  scale                 Float    @default(1)
  views                 Int
  creditedMicros        BigInt
  /// Ganancias del modelo anterior (tarifa fija) convertidas al migrar.
  legacy                Boolean  @default(false)
  /// Fondo de suscripciones del mes: neto reconocido × porcentaje para creadores.
  premiumRevenueMicros  BigInt   @default(0)
  premiumSharePct       Int      @default(0)
  premiumViews          Int      @default(0)
  premiumCreditedMicros BigInt   @default(0)
  closedBy              String?
  closedAt              DateTime @default(now())
}

/// Importe acreditado a un creador al cerrar un mes: por país (anuncios) o
/// por su parte del fondo de suscripciones (premium, país "ZZ").
model EarningCredit {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month        String   @db.VarChar(7)
  /// ADS (RPM real de anuncios) | PREMIUM (reparto de las suscripciones)
  source       String   @default("ADS") @db.VarChar(8)
  country      String   @db.VarChar(2)
  views        Int
  /// RPM real aplicado (micro-USD por 1.000 vistas).
  rpmMicros    BigInt
  amountMicros BigInt
  createdAt    DateTime @default(now())

  @@unique([userId, month, source, country])
  @@index([month])
}

/// Vistas de usuarios premium (sin anuncios) por creador y día: base del
/// reparto del fondo de suscripciones.
model PremiumViewDaily {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  views  Int      @default(0)

  @@id([userId, day])
  @@index([day])
}

/// Suscripción premium (pasarela: PayPal). El acceso premium NO depende del
/// estado, sino de los pagos completados (ver SubscriptionPayment).
model Subscription {
  id                     String                @id @default(cuid())
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider               String                @default("PAYPAL") @db.VarChar(16)
  /// Id de la suscripción en la pasarela (p. ej. "I-ABC123").
  providerSubscriptionId String                @unique
  /// MONTHLY | YEARLY
  plan                   String                @db.VarChar(16)
  /// Estado en la pasarela: APPROVAL_PENDING, ACTIVE, SUSPENDED, CANCELLED, EXPIRED…
  status                 String                @db.VarChar(24)
  /// Próximo cobro según la pasarela (vacío si está cancelada).
  nextBillingAt          DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  payments               SubscriptionPayment[]

  @@index([userId, createdAt])
  @@index([status])
}

/// Cobro de una suscripción (transacción de la pasarela). Idempotente por id.
model SubscriptionPayment {
  id                    String       @id @default(cuid())
  subscriptionId        String
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId                String
  providerTransactionId String       @unique
  grossMicros           BigInt
  feeMicros             BigInt       @default(0)
  /// Neto recibido (bruto − comisión de la pasarela): base del reparto.
  netMicros             BigInt
  currency              String       @default("USD") @db.VarChar(3)
  /// Meses que cubre este cobro (1 mensual, 12 anual): el neto se reparte
  /// entre esos meses para el fondo de los creadores.
  periodMonths          Int
  paidAt                DateTime
  refunded              Boolean      @default(false)
  createdAt             DateTime     @default(now())

  @@index([userId, paidAt])
  @@index([paidAt])
}

enum PayoutStatus {
  PENDING // solicitado por el usuario
  APPROVED // revisado por un administrador, pendiente de enviar
  PAID // enviado (con referencia de la transacción)
  REJECTED // rechazado: el importe vuelve al saldo
}

model Payout {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMicros BigInt
  method       String
  /// Copia del destino en el momento de la solicitud.
  details      String
  status       PayoutStatus @default(PENDING)
  /// Referencia del pago (id de transacción PayPal, hash de la transferencia…).
  reference    String?
  /// Nota del administrador (motivo de rechazo, etc.).
  note         String?
  createdAt    DateTime     @default(now())
  processedAt  DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Ajustes de la plataforma editables desde el panel de administración.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum KycStatus {
  NONE // nunca enviada
  PENDING // enviada, en revisión
  APPROVED // identidad verificada: puede cobrar
  REJECTED // rechazada: puede volver a enviarla
}

/// Solicitud de verificación de identidad. Los documentos se guardan CIFRADOS
/// (AES-256-GCM) fuera de la DB; aquí solo sus claves de almacenamiento.
model IdentityVerification {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            KycStatus @default(PENDING)
  fullName          String
  birthDate         DateTime  @db.Date
  /// ISO 3166-1 alfa-2
  country           String
  /// ID_CARD | PASSPORT | DRIVER_LICENSE
  documentType      String
  /// Número de documento cifrado (base64).
  documentNumberEnc String
  /// Últimos 4 caracteres, para mostrar sin descifrar.
  documentLast4     String
  /// Claves de almacenamiento: { front, back?, selfie }
  files             Json
  /// Motivo del rechazo (visible para el usuario).
  note              String?
  reviewedBy        String?
  reviewedAt        DateTime?
  /// Cuándo se borraron las imágenes (política de retención).
  filesPurgedAt     DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
